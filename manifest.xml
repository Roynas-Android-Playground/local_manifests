<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote name="lineage-a30"
            fetch="https://github.com/LineageOS"
            revision="lineage-24.0" />
    <remote name="royna"
            fetch="https://github.com/Roynas-Android-Playground"
            revision="lineage-24.0" />
    <remote name="external-github"
            fetch="https://github.com" />

    <!-- Upstream has not cut lineage-24.0; this unchanged tip is shared by
         lineage-22.2 through lineage-23.2. -->
    <extend-project path="external/bash"
                    name="LineageOS/android_external_bash"
                    revision="lineage-23.2" />

    <!-- A30 device support -->
    <project path="device/samsung/a30"
             name="device_samsung_a30"
             remote="royna" />
    <project path="device/samsung/exynos7885-common"
             name="device_samsung_exynos7885-common"
             remote="royna" />

    <!-- Proprietary vendor files -->
    <project path="vendor/samsung/a30"
             name="vendor_samsung_a30"
             remote="royna" />
    <project path="vendor/samsung/exynos7885-common"
             name="vendor_samsung_exynos7885-common"
             remote="royna" />

    <!-- EurekaV3 is intentionally frozen independently of the platform branch. -->
    <project path="kernel/samsung/exynos7885"
             name="kernel_samsung_exynos7885-priv"
             remote="royna"
             revision="EurekaV3"
             recurse_submodules="true" />

    <!-- Exynos 7885 legacy userspace retained for Linux 4.4 support -->
    <project path="hardware/samsung_slsi-linaro/graphics"
             name="android_hardware_samsung_slsi-linaro_graphics"
             remote="royna" />
    <project path="hardware/samsung_slsi-linaro/exynos"
             name="android_hardware_samsung_slsi-linaro_exynos"
             remote="royna" />
    <project path="hardware/samsung_slsi-linaro/config"
             name="android_hardware_samsung_slsi-linaro_config"
             remote="royna" />
    <project path="hardware/samsung_slsi-linaro/openmax"
             name="android_hardware_samsung_slsi-linaro_openmax"
             remote="royna" />
    <project path="device/samsung_slsi/sepolicy"
             name="android_device_samsung_slsi_sepolicy"
             remote="royna" />
    <project path="hardware/samsung-ext/interfaces"
             name="hardware_samsung-extra_interfaces"
             remote="royna" />
    <project path="hardware/samsung_sisl/fmradio"
             name="eureka_fm_legacy"
             remote="royna" />

    <!-- LineageOS-maintained Samsung support -->
    <project path="hardware/samsung"
             name="android_hardware_samsung"
             remote="lineage-a30" />
    <project path="hardware/samsung_slsi/libbt"
             name="android_hardware_samsung_slsi_libbt"
             remote="lineage-a30" />
    <project path="hardware/samsung_slsi/scsc_wifibt/wifi_hal"
             name="android_hardware_samsung_slsi_scsc_wifibt_wifi_hal"
             remote="lineage-a30" />
    <project path="hardware/samsung_slsi/scsc_wifibt/wpa_supplicant_lib"
             name="android_hardware_samsung_slsi_scsc_wifibt_wpa_supplicant_lib"
             remote="lineage-a30" />

    <!-- Telephony compatibility -->
    <project path="packages/apps/PhhIms"
             name="krazey/ims"
             remote="external-github"
             revision="main" />
</manifest>
