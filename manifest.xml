<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote name="lineage-a30"
            fetch="https://github.com/LineageOS"
            revision="lineage-24.0" />
    <remote name="royna"
            fetch="https://github.com/Roynas-Android-Playground"
            revision="lineage-24.0" />
    <remote name="external-github"
            fetch="https://github.com" />

    <!-- Upstream has not cut lineage-24.0; this unchanged tip is shared by
         lineage-22.2 through lineage-23.2. -->
    <extend-project path="external/bash"
                    name="LineageOS/android_external_bash"
                    revision="lineage-23.2" />
    <extend-project path="external/htop"
                    name="LineageOS/android_external_htop"
                    revision="lineage-23.2" />
    <extend-project path="external/libncurses"
                    name="LineageOS/android_external_libncurses"
                    revision="lineage-23.2" />
    <extend-project path="external/nano"
                    name="LineageOS/android_external_nano"
                    revision="lineage-23.2" />
    <extend-project path="external/ntfs-3g"
                    name="LineageOS/android_external_ntfs-3g"
                    revision="lineage-23.2" />
    <extend-project path="external/openssh"
                    name="LineageOS/android_external_openssh"
                    revision="lineage-23.2" />
    <extend-project path="external/rsync"
                    name="LineageOS/android_external_rsync"
                    revision="lineage-23.2" />
    <extend-project path="external/unrar"
                    name="LineageOS/android_external_unrar"
                    revision="lineage-23.2" />
    <extend-project path="external/vim"
                    name="LineageOS/android_external_vim"
                    revision="lineage-23.2" />

    <!-- LineageOS has not cut 24.0 branches for these bundled apps yet. -->
    <extend-project path="packages/apps/Aperture"
                    name="LineageOS/android_packages_apps_Aperture"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/AudioFX"
                    name="LineageOS/android_packages_apps_AudioFX"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Backgrounds"
                    name="LineageOS/android_packages_apps_Backgrounds"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Camelot"
                    name="LineageOS/android_packages_apps_Camelot"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Catapult"
                    name="LineageOS/android_packages_apps_Catapult"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/DeskClock"
                    name="LineageOS/android_packages_apps_DeskClock"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Dialer"
                    name="LineageOS/android_packages_apps_Dialer"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Etar"
                    name="LineageOS/android_packages_apps_Etar"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/ExactCalculator"
                    name="LineageOS/android_packages_apps_ExactCalculator"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/FMRadio"
                    name="LineageOS/android_packages_apps_FMRadio"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/FlipFlap"
                    name="LineageOS/android_packages_apps_FlipFlap"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Gallery2"
                    name="LineageOS/android_packages_apps_Gallery2"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Glimpse"
                    name="LineageOS/android_packages_apps_Glimpse"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Jelly"
                    name="LineageOS/android_packages_apps_Jelly"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/LineageCustomizer"
                    name="LineageOS/android_packages_apps_LineageCustomizer"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/LineageParts"
                    name="LineageOS/android_packages_apps_LineageParts"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Messaging"
                    name="LineageOS/android_packages_apps_Messaging"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Profiles"
                    name="LineageOS/android_packages_apps_Profiles"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Recorder"
                    name="LineageOS/android_packages_apps_Recorder"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Twelve"
                    name="LineageOS/android_packages_apps_Twelve"
                    revision="lineage-23.2" />
    <extend-project path="packages/apps/Updater"
                    name="LineageOS/android_packages_apps_Updater"
                    revision="lineage-23.2" />
    <extend-project path="packages/resources/devicesettings"
                    name="LineageOS/android_packages_resources_devicesettings"
                    revision="lineage-23.2" />
    <extend-project path="vendor/crowdin"
                    name="LineageOS/android_vendor_crowdin"
                    revision="lineage-23.2" />

    <!-- A30 device support -->
    <project path="device/samsung/a30"
             name="device_samsung_a30"
             remote="royna" />
    <project path="device/samsung/exynos7885-common"
             name="device_samsung_exynos7885-common"
             remote="royna" />

    <!-- Proprietary vendor files -->
    <project path="vendor/samsung/a30"
             name="vendor_samsung_a30"
             remote="royna" />
    <project path="vendor/samsung/exynos7885-common"
             name="vendor_samsung_exynos7885-common"
             remote="royna" />

    <!-- EurekaV3 is intentionally frozen independently of the platform branch. -->
    <project path="kernel/samsung/exynos7885"
             name="kernel_samsung_exynos7885-priv"
             remote="royna"
             revision="EurekaV3"
             sync-s="true" />

    <!-- Exynos 7885 legacy userspace retained for Linux 4.4 support -->
    <project path="hardware/samsung_slsi-linaro/graphics"
             name="android_hardware_samsung_slsi-linaro_graphics"
             remote="royna" />
    <project path="hardware/samsung_slsi-linaro/exynos"
             name="android_hardware_samsung_slsi-linaro_exynos"
             remote="royna" />
    <project path="hardware/samsung_slsi-linaro/config"
             name="android_hardware_samsung_slsi-linaro_config"
             remote="royna" />
    <project path="hardware/samsung_slsi-linaro/openmax"
             name="android_hardware_samsung_slsi-linaro_openmax"
             remote="royna" />
    <project path="device/samsung_slsi/sepolicy"
             name="android_device_samsung_slsi_sepolicy"
             remote="royna" />
    <project path="hardware/samsung-ext/interfaces"
             name="hardware_samsung-extra_interfaces"
             remote="royna" />
    <project path="hardware/samsung_sisl/fmradio"
             name="eureka_fm_legacy"
             remote="royna" />

    <!-- LineageOS-maintained Samsung support -->
    <project path="hardware/samsung"
             name="android_hardware_samsung"
             remote="lineage-a30" />
    <project path="hardware/samsung_slsi/libbt"
             name="android_hardware_samsung_slsi_libbt"
             remote="lineage-a30" />
    <project path="hardware/samsung_slsi/scsc_wifibt/wifi_hal"
             name="android_hardware_samsung_slsi_scsc_wifibt_wifi_hal"
             remote="lineage-a30" />
    <project path="hardware/samsung_slsi/scsc_wifibt/wpa_supplicant_lib"
             name="android_hardware_samsung_slsi_scsc_wifibt_wpa_supplicant_lib"
             remote="lineage-a30" />

    <!-- Telephony compatibility -->
    <project path="packages/apps/PhhIms"
             name="krazey/ims"
             remote="external-github"
             revision="main"
             sync-s="true" />
</manifest>
